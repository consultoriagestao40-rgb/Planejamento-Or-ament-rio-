generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL_NON_POOLING")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Tenant {
  id           String   @id @default(uuid())
  name         String
  cnpj         String   @unique
  accessToken  String?
  refreshToken String?
  tokenExpiresAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  taxRate      Float    @default(0) // Default tax rate for DAS calculation
  
  budgets      BudgetEntry[]
  realized     RealizedEntry[]
  categories   Category[]
  costCenters  CostCenter[]
  userAccess   UserTenantAccess[]
  locks        CostCenterLock[]
  radarLocks   RadarLock[]
  justifications RealizedJustification[]
  bankAccounts BankAccount[]
  indicatorAnalyses IndicatorAnalysis[]
  detailedAnalyses  DetailedAnalysis[]
  deviations        DeviationAnalysis[]
  forecastContracts ForecastContract[]
  forecastCoefficients ForecastCoefficient[]
}

model RadarLock {
  id           String   @id @default(uuid())
  tenantId     String
  month        Int      // 1-12
  year         Int
  isLocked     Boolean  @default(false)
  deadline     DateTime? // Optional automatic locking deadline
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, month, year])
}


model Category {

  id         String   @id // Financial Category ID from Conta Azul (UUID)
  name       String
  tenantId   String
  parentId   String?
  type       String   // REVENUE / EXPENSE
  entradaDre String?  // Metadata for DRE grouping (e.g., DESPESAS_ADMINISTRATIVAS)
  
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  budgets    BudgetEntry[]
  realized   RealizedEntry[]
  justifications RealizedJustification[]
  indicatorAnalyses IndicatorAnalysis[]
  deviations        DeviationAnalysis[]
  forecastCoefficients ForecastCoefficient[]
}

model CostCenter {
  id        String   @id // Cost Center ID from Conta Azul (UUID)
  name      String
  tenantId  String
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  budgets   BudgetEntry[]
  realized  RealizedEntry[]
  userAccess UserCostCenterAccess[]
  locks      CostCenterLock[]
  justifications RealizedJustification[]
}

model CostCenterLock {
  id           String   @id @default(uuid())
  tenantId     String
  costCenterId String
  year         Int
  isLocked     Boolean  @default(false)
  
  // N1/N2 Approval Workflow Fields
  status       String   @default("PENDING") // PENDING, AWAITING_N2, APPROVED, REJECTED
  
  n1ApprovedBy String?
  n1ApprovedAt DateTime?

  n2ApprovedBy String?
  n2ApprovedAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id])

  @@unique([tenantId, costCenterId, year])
}



model BudgetEntry {
  id           String   @id @default(uuid())
  tenantId     String
  categoryId   String   
  costCenterId String?  
  month        Int      // 1-12
  year         Int
  amount       Float
  radarAmount  Float?
  isLocked     Boolean  @default(false)
  observation  String?  // Optional justification/observation text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  compositionItems BudgetCompositionItem[]

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  category     Category    @relation(fields: [categoryId], references: [id])
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  @@unique([tenantId, categoryId, costCenterId, month, year])
}

model BudgetCompositionItem {
  id           String   @id @default(uuid())
  budgetId     String
  description  String
  amount       Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  budget       BudgetEntry @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model RealizedEntry {
  id           String   @id @default(uuid())
  tenantId     String
  categoryId   String   
  costCenterId String?  
  month        Int      // 1-12
  year         Int
  amount       Float
  description  String?
  customer     String?  // New field for Customer/Supplier
  date         DateTime? // New field for specific transaction date
  externalId   String?
  viewMode     String   @default("competencia") // "caixa" ou "competencia"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  category     Category    @relation(fields: [categoryId], references: [id])
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  @@unique([externalId, viewMode, tenantId])
  @@index([tenantId, categoryId, month, year])
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(GESTOR)
  avatarUrl    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenantAccess     UserTenantAccess[]
  costCenterAccess UserCostCenterAccess[]
  chatSessions     ChatSession[]
  deviations       DeviationAnalysis[]
}

model UserTenantAccess {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

model UserCostCenterAccess {
  id           String   @id @default(uuid())
  userId       String
  costCenterId String
  accessLevel  String   @default("EDITAR") // "LEITOR", "EDITAR", "APROVADOR_N1", "APROVADOR_N2", "APROVADOR_N1_N2"
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  costCenter CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Cascade)

  @@unique([userId, costCenterId])
}

model RealizedJustification {
  id           String   @id @default(uuid())
  tenantId     String
  categoryId   String
  costCenterId String?
  month        Int      // 1-12
  year         Int
  viewMode     String   @default("competencia")
  content      String   @db.Text
  userName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  category     Category    @relation(fields: [categoryId], references: [id])
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  @@index([tenantId, categoryId, month, year])
}

enum Role {
  MASTER
  GESTOR
}

model BankAccount {
  id        String   @id // ID da Conta Financeira no Conta Azul (UUID)
  name      String
  balance   Float
  tenantId  String
  updatedAt DateTime @updatedAt
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model IndicatorAnalysis {
  id                 String             @id @default(uuid())
  tenantId           String
  month              Int                // 1-12
  year               Int
  categoryId         String
  deviationReport    String
  analysisPerformed  String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category           Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  actions            IndicatorAction[]
  comments           IndicatorComment[]

  @@unique([tenantId, categoryId, month, year])
}

model IndicatorAction {
  id           String            @id @default(uuid())
  analysisId   String
  description  String
  dueDate      DateTime
  isDone       Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  analysis     IndicatorAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model IndicatorComment {
  id           String            @id @default(uuid())
  analysisId   String
  userName     String
  content      String
  createdAt    DateTime          @default(now())

  analysis     IndicatorAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model DetailedAnalysis {
  id              String   @id @default(uuid())
  tenantId        String   
  month           Int      
  year            Int      
  
  categoryId      String   
  filterTenantId  String   
  filterCCId      String?  
  chartType       String   
  onlyRealized    Boolean  @default(false)
  showAtingido    Boolean  @default(false)
  pctOfRevenue    Boolean  @default(false)
  chartColor      String   @default("#6366f1")
  
  analysisText    String   @default("")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String        @id @default(uuid())
  title     String
  userId    String
  tenantId  String        // Active tenant filter when created/active
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id              String       @id @default(uuid())
  sessionId       String
  role            String       // "user" or "model"
  content         String       @db.Text
  suggestedAction Json?        // Optional suggested action data
  createdAt       DateTime     @default(now())

  session         ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model DeviationAnalysis {
  id               String    @id @default(uuid())
  tenantId         String
  categoryId       String    // ID da categoria correspondente (ex: 04.8.1)
  month            Int       // 1-12
  year             Int
  deviationType    String    // Tipo/Categoria: "Reclassificar na fonte (Conta Azul)", "Desvios de orçamento", "Reclassificação gerencial" etc.
  description      String    @db.Text
  correctionAction String    @db.Text
  responsibleId    String?   // Usuário responsável pela ação
  responsibleName  String?   // Nome do responsável
  dueDate          DateTime? // Prazo de execução
  isResolved       Boolean   @default(false)
  resolvedAt       DateTime?
  resolvedBy       String?
  resolutionNotes  String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category         Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  responsible      User?     @relation(fields: [responsibleId], references: [id], onDelete: SetNull)

  @@index([tenantId, month, year])
}

model ForecastContract {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  value       Float    // Valor mensal do contrato (R$)
  startMonth  Int      // 1-12
  startYear   Int      // Ano de início (ex: 2026)
  probability Float    // Probabilidade (0-100)
  status      String   // "PIPELINE" | "VENDIDO" | "PERDIDO"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startYear])
}

model ForecastCoefficient {
  id         String   @id @default(uuid())
  tenantId   String
  categoryId String
  percentage Float    // Porcentagem (0-100)
  year       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([tenantId, categoryId, year])
}
